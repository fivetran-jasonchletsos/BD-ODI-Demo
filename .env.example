# Copy to .env and fill in real values. Only needed if you're exercising the
# infra/ Terraform scaffolding directly (terraform validate) -- generating
# seed data, running dbt, and running the frontend do not require any of
# these. Never commit a real .env.

# --- Fivetran REST API credentials ---
FIVETRAN_API_KEY=
FIVETRAN_API_SECRET=

# --- Snowflake destination connection details (fivetran_destination config) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_DATABASE=jason_chletsos_bd
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
